<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      继承 Spring Boot 父 POM。
      它的核心作用是「依赖管理」（dependencyManagement）：统一规定了 Spring Boot
      生态里几百个依赖该用哪个版本。所以我们自己的 <dependencies> 里
      大部分都不用写 <version>，写了反而可能和 Boot 的版本冲突。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.gymlog</groupId>
    <artifactId>gym-log-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gym-log-server</name>
    <description>gym-log backend service</description>

    <properties>
        <!-- 本机只有 JDK 17；Spring Boot 3.x 要求 17+ -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 第三方依赖版本集中在这里，便于统一升级 -->
        <jjwt.version>0.12.7</jjwt.version>
    </properties>

    <dependencies>

        <!--
          starter-web：内嵌 Tomcat + Spring MVC + Jackson(JSON 序列化)
          没有它，连一个 HTTP 接口都提供不了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          starter-validation：提供 JSR-303 校验（@NotNull / @Email / @Size 等）
          步骤 1.5 的注册接口会用到。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          JWT（JSON Web Token）。jjwt 是 Java 生态最常用的实现。

          为什么是三个 artifact：
            jjwt-api    —— 编译期用的接口
            jjwt-impl   —— 运行期实现（scope=runtime，编译时看不到）
            jjwt-jackson—— 用 Jackson 做 JSON 序列化（scope=runtime）

          这样拆分是为了让业务代码只依赖 api，
          换实现（比如换成 nimbus-jose-jwt）时不用改代码。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          只引 spring-security-crypto，不引完整的 starter-security。

          为什么：密码加密只需要 BCryptPasswordEncoder，它在 crypto 这个独立小包里，
          没有任何强制依赖。而完整的 starter-security 一旦引入，
          Spring Security 会**默认锁住所有接口**并生成随机密码，
          步骤 1.5/1.6 的接口就没法直接测了。

          完整的 Security 在第 1.7/1.8 步再引入。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          Lombok：编译期生成 getter/setter/构造器/日志对象。
          只在编译期起作用，运行时不需要，所以标 optional，
          并在下面 spring-boot-maven-plugin 里排除，避免打进最终 jar。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          MySQL 驱动。注意不写 <version>：Spring Boot 的 BOM 已经管好了。
          如果自己去 Maven Central 查"最新版"，会看到 26.x——那是给 Spring Boot 4 的。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          MyBatis-Plus：在 MyBatis 基础上封装了通用 CRUD。
          注意 artifactId 是 mybatis-plus-spring-boot3-starter —— 专供 Spring Boot 3。
          用错成 mybatis-plus-boot-starter 会启动失败（那是给 Boot 2 的）。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!--
          ⚠️ MyBatis-Plus 3.5.9 起，依赖 JSqlParser 的拦截器被**拆到了独立模块**。

          分页插件 PaginationInnerInterceptor 就在其中——只引 starter 的话，
          编译期直接报「cannot be resolved to a type」，
          因为 mybatis-plus-extension 里已经不含这个类了。

          JSqlParser 被拆出去的原因：它是个不小的第三方 SQL 解析库，
          而多数项目只用基础 CRUD，不需要解析 SQL 语句。
          拆开后，不用分页/多租户/动态表名的项目可以少引一个依赖。

          本项目需要分页（列表接口都要），所以必须显式引入。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!--
          Flyway：数据库版本迁移。
          它会在应用启动时扫描 db/migration/V*.sql，按版本号顺序执行，
          并在 flyway_schema_history 表里记录执行状态。
          好处：团队协作时数据库结构变更可追溯、可重放，不靠"我本地手动改了表"。

          flyway-mysql 是 MySQL 的方言支持包，Flyway 10+ 之后必须单独引入。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--
          starter-test：JUnit 5 + Mockito + AssertJ + Spring Test
          scope=test 表示只在测试期可见，不打进最终产物。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                      强制 JVM 以 UTF-8 作为默认字符集。
                      Java 18 之前 file.encoding 默认跟随操作系统（中文 Windows 是 GBK），
                      会导致控制台中文日志乱码、读写文件时中文出错。
                      这里设置后，`mvn spring-boot:run` 启动的进程也会带上。
                    -->
                    <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
                    <excludes>
                        <!-- Lombok 只在编译期需要，从可执行 jar 里排除 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              测试 JVM 也要指定 UTF-8。
              上面 spring-boot-maven-plugin 的 jvmArguments 只对 `mvn spring-boot:run`
              生效；`mvn test` 启动的是 surefire 另开的 JVM，需要单独配置。
              不配的话，MyBatis 打印的 SQL 参数里中文会乱码——
              因为 MyBatis 的 StdOutImpl 直接写 System.out，
              绕过 Logback 的 logging.charset.console 设置。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      测试 JVM 的默认字符集设为 UTF-8。
                      Java 18 之前 file.encoding 跟随操作系统（中文 Windows 是 GBK），
                      不设的话：读写文件时中文出错、new String(bytes) 得到乱码。

                      注意 file.encoding **管不到 System.out** ——
                      Windows 上 System.out 走平台编码，-Dsun.stdout.encoding 也压不住。
                      所以日志输出走 Logback（logging.charset.console: UTF-8），
                      不要用直接写 System.out 的日志实现（如 MyBatis 的 StdOutImpl）。
                    -->
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
